DATABASE_URL=postgresql://user:password@host:5432/database
PAYLOAD_SECRET=replace-with-a-long-random-string
PREVIEW_SECRET=replace-with-a-long-random-string

# Optional — the code-level fallback (lib/constants.ts) already defaults to
# https://rulescale.in without this. Only set it to override that default,
# e.g. for a staging deploy on a different domain. The live, editable source
# of truth for the domain is the Payload "Site Settings" global's URL field.
NEXT_PUBLIC_SITE_URL=

# Optional — the contact form and admin work fully without these (emails log to the console
# instead of sending, Turnstile verification is skipped). Add real values to activate.
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
